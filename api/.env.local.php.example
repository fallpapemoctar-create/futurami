<?php
/**
 * api/.env.local.php.example — MODÈLE
 *
 * Copier ce fichier en `api/.env.local.php` sur les hébergements où les
 * SetEnv du .htaccess sont ignorés par Apache/PHP-FPM (IONOS mutualisé,
 * OVH shared, o2switch, etc.).
 *
 * Le vrai fichier `.env.local.php` :
 *   - N'EST PAS versionné dans git (voir .gitignore).
 *   - N'EST PAS accessible en HTTP (voir bloc <Files> dans .htaccess).
 *   - Est lu automatiquement par api/config.php avant tout traitement.
 *
 * Ordre de priorité :
 *   1. Vraies variables d'environnement du process (SetEnv .htaccess, panneau
 *      d'hébergement, systemd env, etc.) → prioritaires.
 *   2. Ce fichier → fallback silencieux si les vraies vars sont absentes.
 *
 * Retourner un tableau associatif clé => valeur (toutes les valeurs sont
 * traitées comme des chaînes).
 */
return [
    // Secret HS256 signant les tokens JWT — au minimum 32 caractères.
    // À générer avec `openssl rand -hex 48` ou `bin2hex(random_bytes(48))`.
    'AUTH_SECRET'      => 'REMPLACER-PAR-VOTRE-SECRET-64-CHARS-MIN-32-CHARS',

    // Durée de vie du token en secondes (43200 = 12h).
    'AUTH_TOKEN_TTL'   => '43200',

    // Entité Dolibarr cible (2 = PLANETE TRADUCTION FRANCE / futurAMI).
    'DOLIBARR_ENTITY'  => '2',

    // Force l'environnement "prod" si la détection par host ne matche pas.
    'APP_ENV'          => 'prod',

    // Credentials MySQL prod (facultatif — sinon fallback en dur dans config.php).
    // 'DB_HOST_PROD'     => 'db5019265066.hosting-data.io',
    // 'DB_NAME_PROD'     => 'dbs15108425',
    // 'DB_USER_PROD'     => 'dbu1621345',
    // 'DB_PASS_PROD'     => 'Paris2026#',
];
